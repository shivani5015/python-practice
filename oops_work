#Q1
class employee:
  company='genpact'
  def __init__(self,name,location,department,salary):
    self.emp_name=name
    self.emp_location=location
    self.emp_dept=department
    self.emp_salary=salary
  def display(self):
    print(f"emp name is {self.emp_name}")  
    print(f"emp location is {self.emp_location}")
    print(f"emp department is{self.emp_dept}")
    print(f"emp salary is {self.emp_salary}")
    print(f"company is {self.company}")
e1=employee('amit','jaipur','sales',20000)  
e1.display()

