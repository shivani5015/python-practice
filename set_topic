#write a program to rev a list:
def reverse_list(data):
    left = 0
    right = len(data) - 1
    
    # Swap elements until the pointers meet in the middle
    while left < right:
        data[left], data[right] = data[right], data[left]
        left += 1
        right -= 1
    return data

# Testing the function
my_list = [1, 2, 3, 4, 5]
print(f"Manual Reversed: {reverse_list(my_list)}")

