#create a class classteacher that inherits teacher and add section 
#use super() to initialize name and subject 
#print all the values using the display method

class teacher:
  def __init__(self,name,subject):
    self.teacher_name=name
    self.teacher_sub=subject
class classteacher(teacher):
  def __init__(self,name,subject,section):
    super().__init__(name,subject) 
    self.section=section
  def display(self):
    print(f"name of teacher is:{self.teacher_name}")  
    print(f"subject of techer is :{self.teacher_sub}")
    print(f"section is {self.section}")
s1=classteacher('ram','science','a2')  
s1.display()  
