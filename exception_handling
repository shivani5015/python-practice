# 13. program that opens a file, writes data, and ensures it closes using finally.
file_name = input("Enter file name (e.g., test.txt): ")
f = None 
try:
    f = open(file_name, 'w')
    f.write("Hello, this is a test.")
    print("Data written successfully.")
except Exception as e:
    print(f"An error occurred: {e}")
finally:
    if f:
        f.close()
        print("File closed safely.")

