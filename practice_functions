# 36. Write a function to check whether a number is Armstrong or not.
def is_armstrong(num):
    s_num = str(num)
    length = len(s_num)
    total = 0
    for digit in s_num:
        total += int(digit) ** length
        
    if total == num:
        return (f"{num} is an Armstrong number")
    else:
        return (f"{num} is not an Armstrong number")
print(is_armstrong(153)) 


# 37. Write a function that validates a password based on given rules.
def validate_password(password):
    if len(password) < 8:
        return " Password must be at least 8 characters"
    has_upper = False
    has_digit = False
    for char in password:
        if char.isupper():
            has_upper = True
        if char.isdigit():
            has_digit = True
    if not has_upper:
        return "Invalid: Must contain at least one uppercase letter."
    if not has_digit:
        return "Invalid: Must contain at least one digit."

    return "Valid Password!"
