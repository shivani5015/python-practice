# 3. Find the sum of first n natural numbers using recursion.
def calculate_sum(n):
    if n == 0:
        return 0
    return n + calculate_sum(n - 1)
n = int(input("Enter a value: "))
result = calculate_sum(n)
print(result)

# 4. Find the factorial of a number using recursion.
def fact_num(n):
  if n==0:
    return 1
  return n*fact_num(n-1)
n=int(input("enter"))
res=fact_num(n)
print(res)   

# 5. Find the power of a number a^b using recursion.
def power(b,p):
  if p==0:
    return 1
  return b*power(b,p-1)
b=int(input("enter b")) 
p=int(input("enter p")) 
res=power(b,p)
print(f"the power of number is:{res}")

# 6. Find the sum of digits of a number using recursion.
def sum_digits(n):
    if n == 0:
        return 0
    return (n % 10) + sum_digits(n // 10)
num = int(input("Enter a number: "))
result = sum_digits(num)
print(result)

# 7. Reverse a number using recursion.
def reverse_number(n, rev=0):
    if n == 0:
        return rev
    return reverse_number(n // 10, rev * 10 + n % 10)
num = int(input("Enter a number: "))
result = reverse_number(num)
print(result)

# 8. Check whether a number is a palindrome using recursion.
def get_reverse(n, rev=0):
    if n == 0:
        return rev
    return get_reverse(n // 10, rev * 10 + n % 10)
def is_palindrome(n):
    return n == get_reverse(n)

num = int(input("Enter a number: "))
if is_palindrome(num):
    print(f"{num} is a palindrome.")
else:
    print(f"{num} is not a palindrome.")

# 9. Find the nth Fibonacci number using recursion.
def fibonacci(n):
    if n <= 1:
        return n
    return fibonacci(n - 1) + fibonacci(n - 2)

n = int(input("Enter the value of n: "))
print(f"The {n}th Fibonacci number is: {fibonacci(n)}")


